# SentinelShield Environment Variables Example
# Copy this file to .env for local overrides

DEBUG=True
SECRET_KEY=sentinelshield-dev-secret-key-change-in-production-!@#$99
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Security Policy Configuration
SENTINEL_MODE=ENFORCE
SENTINEL_BODY_LIMIT_BYTES=262144
SENTINEL_RATE_LIMIT_THRESHOLD=30
SENTINEL_RATE_LIMIT_WINDOW_SECS=60
SENTINEL_RATE_LIMIT_BLOCK_SECS=300
SENTINEL_TRUSTED_PROXIES=

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3
